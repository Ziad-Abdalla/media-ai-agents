   "compression_ratio": 1.9403669724770642
  },
  {
   "start": 29.06,
   "end": 37.74,
   "text": "عبود تراك صدقت نفسك ومسوي عمرك أجنبي يا ابن الحلال انت بالنفسك لا تتمصع تراك كلك عدب ما فيك ولا لحم",
   "avg_logprob": -0.219542577970719,
   "no_speech_prob": 0.0,
   "compression_ratio": 1.9403669724770642
  },
  {
   "start": 37.74,
   "end": 44.06,
