# Copy to .env (or keep one shared .env in the parent folder; it is found automatically).
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-haiku-5-5

# Cost tracking (shared ledger + hard budget, see ../agent-cost-tracker)
COST_DB_PATH=./costs.sqlite
COST_BUDGET_USD=15

# Mailpit (docker compose up -d). Host ports 1027 (SMTP) and 8027 (web UI + API).
MAILPIT_URL=http://localhost:8027
SMTP_HOST=localhost
SMTP_PORT=1027

# Agent storage and safety
AGENT_DB_PATH=./inbox_agent.sqlite
STAFF_FILE=./data/staff.yaml
KILL_SWITCH_FILE=./agent.kill
AGENT_WRITES_ENABLED=true

# Thread linking: local multilingual embedding model (free, runs on CPU or GPU)
EMBEDDING_MODEL=intfloat/multilingual-e5-base
THREAD_SIMILARITY_THRESHOLD=0.88

# Corrections fed back as examples on the next run (bounded)
MAX_CORRECTION_EXAMPLES=6

# KPI assumption: minutes a person spends triaging one email by hand
MANUAL_TRIAGE_MINUTES=3

# Gmail (optional, instead of Mailpit; read-only scope)
GMAIL_LABEL=ceo-office
