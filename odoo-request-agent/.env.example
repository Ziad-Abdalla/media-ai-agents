ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-haiku-5-5

# Cost tracking (shared ledger + hard budget, see agent-cost-tracker)
COST_DB_PATH=./costs.sqlite
COST_BUDGET_USD=15

# Odoo (local docker stack by default)
ODOO_URL=http://localhost:8069
ODOO_DB=sadaf_demo
ODOO_USER=admin
ODOO_PASSWORD=admin

# Mail
MAILPIT_URL=http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
AGENT_EMAIL=procurement-agent@sadaf.example

# Safety
COMPANY_DOMAINS=sadaf.example
ALLOWED_CURRENCIES=SAR,USD
AGENT_WRITES_ENABLED=true
AGENT_DB_PATH=./agent.sqlite
KILL_SWITCH_FILE=./agent.kill

# Gmail (optional, instead of Mailpit)
GMAIL_LABEL=purchase-requests

# Productions (Odoo analytic accounts under this plan) and their budgets
PRODUCTION_PLAN=Productions
# BUDGETS_FILE=./production_budgets.json

# KPI report: assumptions behind "minutes saved" (change them to your own measured times)
MINUTES_MANUAL_PO=12
MINUTES_REVIEW_PO=2
MINUTES_PER_REPLY=3
