[
  {
    "id": "pgBookings000001",
    "name": "Bookings Postgres",
    "type": "postgres",
    "data": {
      "host": "postgres",
      "port": 5432,
      "database": "bookings_app",
      "user": "bookings",
      "password": "${POSTGRES_PASSWORD}",
      "ssl": "disable"
    }
  },
  {
    "id": "smtpMailpit00001",
    "name": "Mailpit SMTP",
    "type": "smtp",
    "data": {
      "host": "mailpit",
      "port": 1025,
      "secure": false,
      "disableStartTls": true,
      "user": "",
      "password": ""
    }
  },
  {
    "id": "webhookLogin0001",
    "name": "Mailpit webhook login",
    "type": "httpBasicAuth",
    "data": {
      "user": "mailpit",
      "password": "${WEBHOOK_PASSWORD}"
    }
  },
  {
    "id": "anthropicKey0001",
    "name": "Anthropic API key",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-api-key",
      "value": "${ANTHROPIC_API_KEY}"
    }
  },
  {
    "id": "odooLocal0000001",
    "name": "Odoo (local demo)",
    "type": "odooApi",
    "data": {
      "url": "${ODOO_URL}",
      "username": "${ODOO_USER}",
      "password": "${ODOO_PASSWORD}",
      "db": "${ODOO_DB}"
    }
  }
]
