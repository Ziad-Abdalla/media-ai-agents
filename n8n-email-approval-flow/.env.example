# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=sk-ant-...
POSTGRES_PASSWORD=localdev
# Password Mailpit uses to call the n8n webhook
WEBHOOK_PASSWORD=localhook
# Login for the local n8n editor (created by scripts/setup.py)
N8N_OWNER_EMAIL=admin@sadafprod.test
N8N_OWNER_PASSWORD=ChangeMe123
# Optional Odoo link (off by default; see scripts/odoo_link.py). These point at the local
# Odoo from the odoo-request-agent project. host.docker.internal = your machine, seen from Docker.
ODOO_URL=http://host.docker.internal:8069
ODOO_DB=sadaf_demo
ODOO_USER=admin
ODOO_PASSWORD=admin
